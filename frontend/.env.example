# CodeSentry frontend environment. Copy to .env (dev) or set in Vercel (prod).

# Dev only: the Vite dev server proxies /api to http://127.0.0.1:8000.
# Production (Vercel): set to the Render backend URL, e.g. https://codesentry-backend.onrender.com
VITE_API_BASE=

# Supabase auth (optional). Leave unset to disable sign-in / scan history.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=