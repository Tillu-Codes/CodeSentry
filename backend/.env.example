# CodeSentry backend configuration. Copy to .env and fill in what you need.
# LLM layer is optional: leave LLM_PROVIDER unset and /scan runs rules only.

# groq | gemini | ollama | mock
LLM_PROVIDER=groq

# Groq (default, fastest free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (no key needed)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-coder

# --- Supabase (Phase 5: optional auth + scan history) ---
# With these unset, authentication is disabled and anonymous scans are not persisted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify access tokens; audience must be "authenticated".
SUPABASE_JWT_SECRET=

# --- CORS (Phase 7) ---
# Comma-separated origins allowed to call this API. Leave empty for "*" (dev).
# In production set to your Vercel frontend URL, e.g. https://codesentry.vercel.app
CORS_ORIGINS=